      </sensor>
      <sensor name='velodyne-VLP16' type='ray'>
        <visualize>1</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.57</min_angle>
              <max_angle>1.57</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples> <!-- 16 samples for 3D lidar effect -->
              <resolution>1</resolution>
              <!-- <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle> -->
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>130</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name='pioneer_gazebo_ros_laser_controller' filename='libgazebo_ros_velodyne_laser.so'>
          <topicName>/velodyne_points</topicName>
          <frameName>velodyne</frameName>
          <min_range>0.1</min_range>
          <max_range>130.0</max_range>
          <gaussianNoise>0.008</gaussianNoise>
          <min_intensity>0.0</min_intensity>
        </plugin>
        <pose>0.125 0 0.27 0 -0 0</pose>
      </sensor>

      <sensor name="fisheye_camera" type="wideanglecamera">
      <!-- <sensor name="fisheye_camera" type="camera"> -->
        <!-- <pose>0.130 0 1.35 0 -0 0</pose> -->
        <pose>0.135 0 0.45 0 -0 0</pose>
        <static>true</static>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <visualize>1</visualize>
        <camera>
          <horizontal_fov>3.1415</horizontal_fov>
          <!-- <horizontal_fov>2.09</horizontal_fov> -->
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.01</near>
            <far>100</far>
          </clip>
          <lens>
            <scale_to_hfov>true</scale_to_hfov>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name="fisheye_camera_controller" filename="libgazebo_ros_camera.so">
          <frame_name>fisheye_camera</frame_name>
          <alwaysOn>true</alwaysOn>
        </plugin>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <pose>0 0 0 0 0 0</pose>  <!-- Adjust the pose if needed -->
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <topicName>imu</topicName>
          <bodyName>base_link</bodyName>
          <updateRateHZ>100.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>    <!-- TODO: Add noise -->
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>imu</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>

